@model EmployeesViewModel
@{
    ViewData["Title"] = "Employees";
}

<h1 class="mb-4">Employees</h1>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Name</th>
            <th class="text-end">Total Time Worked (hours)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr class="@(employee.TotalHours < EmployeesViewModel.LowHoursLimit ? "table-danger" : null)">
                <td>@employee.Name</td>
                <td class="text-end">@employee.TotalHours.ToString("0.##")</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="mt-5 mb-3">Percentage of total time worked</h2>
<img src="data:image/png;base64,@Model.PieChart" alt="Pie chart" class="img-fluid border" />
